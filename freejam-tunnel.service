[Unit]
Description=FreeJam Cloudflare Quick Tunnel
After=network-online.target freejam-relay.service
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/cloudflared tunnel --url http://127.0.0.1:8787
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
