[Unit]
Description=FreeJam relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freejam
WorkingDirectory=/home/freejam/freejam
ExecStart=/usr/bin/node /home/freejam/freejam/freejam-relay.js
Environment=PORT=8787
Environment=HOST=127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
