#!/bin/sh
# Post-merge hook: keep the live extension and the relay in sync after `git pull`.
#
# - freejam.js changed      -> copy into Spicetify and re-apply it.
# - freejam-relay.js changed -> just a reminder: the relay is self-hosted, so restart your own.
#
# Set FREEJAM_DRY_RUN=1 to preview the actions, or FREEJAM_NO_RESTART=1 to
# apply the extension without restarting Spotify.

set -e

repo_root=$(git rev-parse --show-toplevel)

changed_js=0
changed_relay=0
if git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
    if git diff --name-only ORIG_HEAD HEAD -- freejam.js | grep -q .; then
        changed_js=1
    fi
    if git diff --name-only ORIG_HEAD HEAD -- freejam-relay.js | grep -q .; then
        changed_relay=1
    fi
else
    # No ORIG_HEAD (for example, running the hook manually): sync everything.
    changed_js=1
    changed_relay=1
fi

if [ "$changed_js" -eq 0 ] && [ "$changed_relay" -eq 0 ]; then
    exit 0
fi

dry_run=""
if [ "${FREEJAM_DRY_RUN:-0}" = "1" ]; then
    dry_run="-DryRun"
fi

if [ "$changed_js" -eq 1 ]; then
    no_restart=""
    if [ "${FREEJAM_NO_RESTART:-0}" = "1" ]; then
        no_restart="-NoRestart"
    fi

    powershell.exe -NoProfile -ExecutionPolicy RemoteSigned \
        -File "$repo_root/scripts/sync-to-spicetify.ps1" $dry_run $no_restart
fi

if [ "$changed_relay" -eq 1 ]; then
    echo "FreeJam: freejam-relay.js changed. Restart your own relay to use the new version."
fi
