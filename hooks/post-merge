#!/bin/sh
# Post-merge hook: keep the live Spicetify extension in sync after `git pull`.
#
# Only runs when freejam.js changed in the pull. Set FREEJAM_DRY_RUN=1 to
# preview the actions, or FREEJAM_NO_RESTART=1 to apply without restarting
# Spotify.

set -e

repo_root=$(git rev-parse --show-toplevel)

changed=0
if git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
    if git diff --name-only ORIG_HEAD HEAD -- freejam.js | grep -q .; then
        changed=1
    fi
else
    # No ORIG_HEAD (for example, running the hook manually): sync anyway.
    changed=1
fi

if [ "$changed" -eq 0 ]; then
    exit 0
fi

dry_run=""
if [ "${FREEJAM_DRY_RUN:-0}" = "1" ]; then
    dry_run="-DryRun"
fi

no_restart=""
if [ "${FREEJAM_NO_RESTART:-0}" = "1" ]; then
    no_restart="-NoRestart"
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$repo_root/scripts/sync-to-spicetify.ps1" $dry_run $no_restart
