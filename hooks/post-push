#!/bin/sh
# Post-push hook: refresh the installed Spicetify extension after a successful push.
# Set FREEJAM_DRY_RUN=1 to preview, or FREEJAM_NO_RESTART=1 to apply without restarting Spotify.

set -e

repo_root=$(git rev-parse --show-toplevel)

dry_run=""
if [ "${FREEJAM_DRY_RUN:-0}" = "1" ]; then
    dry_run="-DryRun"
fi

no_restart=""
if [ "${FREEJAM_NO_RESTART:-0}" = "1" ]; then
    no_restart="-NoRestart"
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$repo_root/scripts/sync-to-spicetify.ps1" $dry_run $no_restart
