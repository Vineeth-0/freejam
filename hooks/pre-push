#!/bin/sh
# Pre-push hook: refresh the installed Spicetify extension before a push.
# Only runs when freejam.js changed in the commits being pushed.
# Set FREEJAM_DRY_RUN=1 to preview, or FREEJAM_NO_RESTART=1 to apply without
# restarting Spotify.

set -e

repo_root=$(git rev-parse --show-toplevel)

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
if [ -n "$upstream" ]; then
    if ! git diff --name-only "$upstream"...HEAD -- freejam.js | grep -q .; then
        exit 0
    fi
fi

dry_run=""
if [ "${FREEJAM_DRY_RUN:-0}" = "1" ]; then
    dry_run="-DryRun"
fi

no_restart=""
if [ "${FREEJAM_NO_RESTART:-0}" = "1" ]; then
    no_restart="-NoRestart"
fi

powershell.exe -NoProfile -ExecutionPolicy RemoteSigned \
    -File "$repo_root/scripts/sync-to-spicetify.ps1" $dry_run $no_restart
